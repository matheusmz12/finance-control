# Copie este arquivo para ".env" e preencha com os seus dados.
# O ".env" de verdade nunca deve ir para o GitHub.

DB_NAME=finance_control
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost

PORT=3000

# Frase longa e aleatória usada para assinar os tokens de login
JWT_SECRET=

# Endereço do frontend permitido pelo CORS (vazio = qualquer origem, só para desenvolvimento)
CORS_ORIGIN=http://localhost:5173
